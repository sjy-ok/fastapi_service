APP_APP_NAME=FastAPI Service
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_DOCS_ENABLED=true
APP_DATABASE__URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
APP_DATABASE__ECHO=false
APP_DATABASE__POOL_SIZE=10
APP_DATABASE__MAX_OVERFLOW=20
APP_DATABASE__POOL_PRE_PING=true
APP_LOGGING__LEVEL=INFO

